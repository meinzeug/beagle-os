[Unit]
Description=Beagle thin-client microphone audio bridge
After=display-manager.service beagle-usb-attach.service
Wants=display-manager.service beagle-usb-attach.service

[Service]
Type=simple
User=beagle
Environment=HOME=/home/beagle
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=BEAGLE_TC_MIC_BRIDGE_HOST=192.168.123.1
Environment=BEAGLE_TC_MIC_BRIDGE_PORT=43200
Environment=BEAGLE_TC_MIC_RATE=48000
Environment=BEAGLE_TC_MIC_CHANNELS=1
RuntimeDirectory=beagle
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/beagle-tc-mic-bridge
Restart=always
RestartSec=2s

[Install]
WantedBy=graphical.target