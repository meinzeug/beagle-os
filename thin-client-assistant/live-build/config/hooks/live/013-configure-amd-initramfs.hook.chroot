#!/bin/sh
set -eu

mkdir -p /etc/initramfs-tools

cat >/etc/initramfs-tools/modules <<'EOF'
# Beagle thin clients should bring up the primary GPU early on old and new
# AMD/Intel/NVIDIA hardware. Early KMS keeps legacy laptop firmware from
# falling back to broken VESA paths after the bootloader hands off.
amdgpu
radeon
i915
nouveau
drm
drm_kms_helper
ttm
gpu_sched
i2c-algo-bit
EOF

if command -v update-initramfs >/dev/null 2>&1; then
  update-initramfs -u >/dev/null 2>&1 || true
fi
