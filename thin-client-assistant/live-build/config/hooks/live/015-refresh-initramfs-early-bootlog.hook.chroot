#!/bin/sh
set -eu

for script_path in \
  /etc/initramfs-tools/scripts/init-premount/10-beagle-early-bootlog \
  /etc/initramfs-tools/scripts/init-bottom/20-beagle-early-bootlog-persist
do
  if [ -f "$script_path" ]; then
    chmod 0755 "$script_path" || true
  fi
done

if command -v update-initramfs >/dev/null 2>&1; then
  update-initramfs -u >/dev/null 2>&1 || true
fi
