#!/bin/sh
set -e

enable_if_present() {
  unit="$1"
  if [ -e "/etc/systemd/system/$unit" ] || [ -e "/lib/systemd/system/$unit" ] || [ -e "/usr/lib/systemd/system/$unit" ]; then
    systemctl enable "$unit"
  fi
}

ensure_wantedby_symlink() {
  unit="$1"
  target="$2"
  install -d -m 0755 "/etc/systemd/system/${target}.wants"
  ln -sfn "$unit" "/etc/systemd/system/${target}.wants/$(basename "$unit")"
}

systemctl enable systemd-networkd.service
systemctl enable systemd-networkd-wait-online.service
ensure_wantedby_symlink /etc/systemd/system/beagle-thin-client-prepare.service multi-user.target
ensure_wantedby_symlink /etc/systemd/system/pve-thin-client-runtime.service multi-user.target
ensure_wantedby_symlink /etc/systemd/system/pve-thin-client-installer-menu.service multi-user.target
ensure_wantedby_symlink /etc/systemd/system/pve-thin-client-installer-menu-serial.service multi-user.target
ensure_wantedby_symlink /etc/systemd/system/beagle-kiosk.service beagle-kiosk.target
systemctl enable getty@tty1.service
systemctl enable ssh.service
enable_if_present beagle-camera-stream.service

# Ensure /etc/machine-id is world-readable so D-Bus and PipeWire can read it.
# On live systems the file is often created with mode 0600 (root-only), which
# prevents user-space services (pipewire, wireplumber) from using D-Bus/RTKit.
chmod 0644 /etc/machine-id 2>/dev/null || true
