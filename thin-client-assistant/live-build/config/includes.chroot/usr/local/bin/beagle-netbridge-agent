    "BEAGLE_NETBRIDGE_STREAM_PROFILE_FILE",
    "/var/lib/beagle-os/stream-profile.env",
)
USBCTL = os.environ.get(
    "BEAGLE_NETBRIDGE_USBCTL",
    "/usr/local/lib/pve-thin-client/runtime/beagle-usbctl.sh",
)

