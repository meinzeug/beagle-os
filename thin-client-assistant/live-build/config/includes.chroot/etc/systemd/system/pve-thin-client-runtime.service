[Unit]
Description=Thinclient Runtime Session Bootstrap
Documentation=file:///usr/local/lib/pve-thin-client/README.md
ConditionKernelCommandLine=pve_thin_client.mode=runtime
ConditionPathExists=/usr/local/bin/pve-thin-client-start-x11
ConditionPathExists=/usr/local/lib/pve-thin-client/runtime/runtime_getty_session_owner.sh
After=local-fs.target systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target network.target pve-thin-client-network-menu.service beagle-thin-client-prepare.service
Wants=plymouth-quit-wait.service network.target pve-thin-client-network-menu.service beagle-thin-client-prepare.service getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pve-thin-client/runtime/runtime_getty_session_owner.sh
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
