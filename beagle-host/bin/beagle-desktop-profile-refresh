WEB_APPS = [
    ("beagle-chatgpt.desktop", "ChatGPT", "https://chatgpt.com", "google-chrome"),
    ("beagle-microsoft-365.desktop", "Microsoft 365", "https://www.office.com", "libreoffice-startcenter"),
    ("beagle-google-workspace.desktop", "Google Workspace", "https://workspace.google.com/dashboard", "google-chrome"),
    ("beagle-gmail.desktop", "Gmail", "https://mail.google.com", "internet-mail"),
    ("beagle-whatsapp.desktop", "WhatsApp Web", "https://web.whatsapp.com", "internet-chat"),
    ("beagle-discord.desktop", "Discord", "https://discord.com/app", "internet-chat"),
    ("beagle-youtube.desktop", "YouTube", "https://www.youtube.com", "applications-multimedia"),
]


def utcnow() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(command: list[str], *, check: bool = True, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    APT_LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with APT_LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write("+ " + " ".join(command) + "\n")
        completed = subprocess.run(command, env=env, stdout=handle, stderr=subprocess.STDOUT, text=True, check=False)
    if check and completed.returncode != 0:
        raise RuntimeError(f"command failed: {' '.join(command)}")
    return completed


def load_env(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if not path.is_file():
        return result
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        result[key.strip()] = value.strip().strip('"').strip("'")
    return result


def read_state() -> dict:
    if not STATE_FILE.is_file():
        return {}
    try:
        payload = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


def write_state(payload: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = STATE_FILE.with_suffix(".json.tmp")
    tmp_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp_path.replace(STATE_FILE)


def profile_current() -> bool:
    return str(read_state().get("profile_version", "") or "") == PROFILE_VERSION


def desktop_user(config: dict[str, str]) -> str:
    configured = str(config.get("BEAGLE_DESKTOP_PROFILE_USER") or config.get("BEAGLE_GUEST_USER") or "").strip()
    if configured:
        try:
            pwd.getpwnam(configured)
            return configured
        except KeyError:
            pass
    for home in sorted(Path("/home").iterdir() if Path("/home").is_dir() else []):
        if not home.is_dir():
            continue
        try:
            info = pwd.getpwnam(home.name)
        except KeyError:
            continue
        if info.pw_uid >= 1000:
            return home.name
    raise RuntimeError("no desktop user found")


def apt_install(packages: list[str], *, required: bool = True) -> list[str]:
    if not packages:
        return []
    env = dict(os.environ)
    env["DEBIAN_FRONTEND"] = "noninteractive"
    command = ["apt-get", "install", "-y", "--fix-missing", "--no-install-recommends", *packages]
    completed = run(command, check=False, env=env)
    if completed.returncode == 0:
        return []
    failed: list[str] = []
    for package in packages:
        single = run(["apt-get", "install", "-y", "--fix-missing", "--no-install-recommends", package], check=False, env=env)
        if single.returncode != 0:
            failed.append(package)
    if failed and required:
        raise RuntimeError(f"package install failed: {', '.join(failed)}")
    return failed


def ensure_vscode_repo() -> None:
    keyring = Path("/etc/apt/keyrings/packages.microsoft.gpg")
    source = Path("/etc/apt/sources.list.d/vscode.list")
    if keyring.is_file() and source.is_file():
        return
    Path("/etc/apt/keyrings").mkdir(parents=True, exist_ok=True)
    if not keyring.is_file():
        run(["/bin/sh", "-c", f"wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > {keyring}"])
        keyring.chmod(0o644)
    source.write_text("deb [arch=amd64 signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main\n", encoding="utf-8")


def ensure_flathub() -> None:
    if not shutil.which("flatpak"):
        return
    run(
        [
            "flatpak",
            "remote-add",
            "--if-not-exists",
            "flathub",
            "https://flathub.org/repo/flathub.flatpakrepo",
        ],
        check=False,
    )


def write_web_apps() -> None:
    app_dir = Path("/usr/local/share/applications")
    share_dir = Path("/usr/local/share/beagle")
    app_dir.mkdir(parents=True, exist_ok=True)
    share_dir.mkdir(parents=True, exist_ok=True)
    for filename, name, url, icon in WEB_APPS:
        (app_dir / filename).write_text(
            "\n".join(
                [
                    "[Desktop Entry]",
                    "Version=1.0",
                    "Type=Application",
                    f"Name={name}",
                    f"Exec=google-chrome --app={url} --new-window --disable-session-crashed-bubble --no-first-run",
                    f"Icon={icon}",
                    "Categories=Network;Office;Utility;",
                    "StartupNotify=true",
                    "NoDisplay=false",
                    "",
                ]
            ),
            encoding="utf-8",
        )
    (share_dir / "beagle-launchpad.html").write_text(
        """<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Beagle Launchpad</title>
  <style>
    :root { color-scheme: dark; --bg: #070b14; --panel: rgba(14,20,36,.82); --line: rgba(0,245,255,.28); --text: #e8f4f8; --muted: #8da3b3; --cyan: #00f5ff; --pink: #ff006e; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; background: radial-gradient(circle at 18% 12%, rgba(124,60,255,.28), transparent 34%), radial-gradient(circle at 86% 18%, rgba(0,245,255,.18), transparent 30%), linear-gradient(135deg, #070b14 0%, #10172a 48%, #090d18 100%); color: var(--text); padding: 40px; }
    header, main { max-width: 1040px; margin: 0 auto; }
    header { margin-bottom: 28px; }
    h1 { margin: 0 0 8px; font-size: clamp(34px, 5vw, 64px); line-height: .95; letter-spacing: 0; }
    p { margin: 0; color: var(--muted); font-size: 18px; }
    main { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
    a { min-height: 112px; border: 1px solid var(--line); background: var(--panel); color: var(--text); text-decoration: none; border-radius: 8px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 20px 60px rgba(0,0,0,.22); }
    a:hover { border-color: var(--cyan); transform: translateY(-1px); }
