PROFILE_VERSION = "2026-06-14-cyberpunk-standard-apps-v2"
STATE_FILE = Path("/var/lib/beagle/guest-updater/desktop-profile.json")
APT_LOG_FILE = Path("/var/lib/beagle/guest-updater/desktop-profile-last.log")

DESKTOP_PACKAGES = [
    "plasma-desktop",
    "kwin-x11",
