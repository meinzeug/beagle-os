    )
    (config / "kscreenlockerrc").write_text(
        """[Daemon]
Autolock=false
LockOnResume=false
Timeout=0
""",
        encoding="utf-8",
    )
    (config / "plasma-org.kde.plasma.desktop-appletsrc").write_text(
        """[Containments][1]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=file:///usr/share/backgrounds/beagle-cyberpunk-wallpaper.png

[Containments][2]
formfactor=2
immutability=1
lastScreen=0
