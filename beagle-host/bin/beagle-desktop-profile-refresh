def write_kde_profile(username: str) -> None:
    home = Path("/home") / username
    config = home / ".config"
    color_dir = home / ".local/share/color-schemes"
    config.mkdir(parents=True, exist_ok=True)
    color_dir.mkdir(parents=True, exist_ok=True)
    (color_dir / "BeagleCyberpunk.colors").write_text(
        """[ColorScheme]
Name=BeagleCyberpunk

[Colors:Window]
BackgroundNormal=7,11,20
ForegroundNormal=232,244,248

[Colors:View]
BackgroundNormal=12,18,32
DecorationFocus=0,245,255
ForegroundNormal=232,244,248

[Colors:Selection]
BackgroundNormal=255,0,110
ForegroundNormal=255,255,255

[General]
ColorScheme=BeagleCyberpunk
Name=BeagleCyberpunk
shadeSortColumn=true
""",
        encoding="utf-8",
    )
    (config / "kdeglobals").write_text(
        """[General]
ColorScheme=BeagleCyberpunk
Name=BeagleCyberpunk
fixed=Hack,10,-1,5,50,0,0,0,0,0
font=IBM Plex Sans,10,-1,5,50,0,0,0,0,0
menuFont=IBM Plex Sans,10,-1,5,50,0,0,0,0,0
