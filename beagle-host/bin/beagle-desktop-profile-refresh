[Containments][2][Applets][4][Configuration][General]
launchers=applications:beagle-launchpad.desktop,applications:google-chrome.desktop,applications:beagle-chatgpt.desktop,applications:thunderbird.desktop,applications:libreoffice-writer.desktop,applications:org.kde.okular.desktop,applications:org.kde.spectacle.desktop,applications:org.kde.discover.desktop,applications:org.kde.konsole.desktop,applications:org.kde.dolphin.desktop

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.marginsseparator

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][2][Applets][7]
immutability=1
plugin=org.kde.plasma.digitalclock
""",
        encoding="utf-8",
    )
    (config / "mimeapps.list").write_text(
        """[Default Applications]
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop
x-scheme-handler/about=google-chrome.desktop
x-scheme-handler/unknown=google-chrome.desktop
""",
        encoding="utf-8",
    )
    uid = pwd.getpwnam(username).pw_uid
    gid = pwd.getpwnam(username).pw_gid
    for path in [config, color_dir, *config.glob("*"), *color_dir.glob("*")]:
        os.chown(path, uid, gid)


def maybe_repair_plasma() -> None:
    if shutil.which("beagle-plasma-desktop-repair"):
        run(["beagle-plasma-desktop-repair"], check=False)


def apply_profile(*, force: bool = False) -> dict:
    if profile_current() and not force:
        return {"changed": False, "profile_version": PROFILE_VERSION, "state": "current"}
    config = load_env(Path("/etc/beagle/guest-updater.env"))
    user = desktop_user(config)
    APT_LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    APT_LOG_FILE.write_text(f"# beagle desktop profile refresh {utcnow()}\n", encoding="utf-8")
    env = dict(os.environ)
    env["DEBIAN_FRONTEND"] = "noninteractive"
    run(["apt-get", "update", "-o", "Acquire::Retries=5"], env=env)
    ensure_vscode_repo()
    run(["apt-get", "update", "-o", "Acquire::Retries=5"], env=env)
    failed_optional = apt_install([*DESKTOP_PACKAGES, *STANDARD_PACKAGES], required=False)
    code_failed = apt_install(["code"], required=False)
    ensure_flathub()
    write_web_apps()
    write_kde_profile(user)
    maybe_repair_plasma()
    state = {
        "changed": True,
        "profile_version": PROFILE_VERSION,
        "desktop_user": user,
        "applied_at": utcnow(),
        "failed_optional_packages": failed_optional + code_failed,
        "state": "current" if not failed_optional and not code_failed else "partial",
    }
    write_state(state)
    return state


def main() -> int:
    parser = argparse.ArgumentParser(description="Apply Beagle OS desktop profile updates inside a guest VM.")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        if args.check:
            payload = {"current": profile_current(), "profile_version": PROFILE_VERSION, "state": read_state()}
        else:
            payload = apply_profile(force=args.force)
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        return 0 if payload.get("state") != "partial" else 2
    except Exception as exc:
        write_state({"state": "error", "profile_version": PROFILE_VERSION, "last_error": str(exc), "updated_at": utcnow()})
        print(f"beagle-desktop-profile-refresh: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
