            ]
            for key in ("resolution", "fps", "bitrate", "packet_size", "video_codec", "video_decoder", "frame_pacing", "vsync", "display_mode", "audio_config"):
                if key in values:
                    rows.append([value_labels.get(key, key), values.get(key)])
            self._set_rows(self.stream_table, rows)
            self._sync_custom_stream_controls(values)

        def _combo_set_text(self, combo, value: object) -> None:
            text = str(value or "").strip()
            if not text:
                return
            index = combo.findText(text)
            if index >= 0:
                combo.setCurrentIndex(index)

        def _sync_custom_stream_controls(self, values: dict) -> None:
            if not isinstance(values, dict):
                return
            self._combo_set_text(self.custom_resolution, values.get("resolution"))
            self._combo_set_text(self.custom_codec, values.get("video_codec"))
            self._combo_set_text(self.custom_decoder, values.get("video_decoder"))
            for widget, key in (
                (self.custom_fps, "fps"),
                (self.custom_bitrate, "bitrate"),
                (self.custom_packet_size, "packet_size"),
            ):
                try:
                    numeric = int(str(values.get(key, "")).split()[0])
                except (TypeError, ValueError):
                    continue
                if widget.minimum() <= numeric <= widget.maximum():
                    widget.setValue(numeric)
            self.custom_frame_pacing.setChecked(str(values.get("frame_pacing", "")).lower() in {"1", "true", "yes"})
            self.custom_vsync.setChecked(str(values.get("vsync", "")).lower() in {"1", "true", "yes"})
            self.custom_absolute_mouse.setChecked(str(values.get("absolute_mouse", "")).lower() in {"1", "true", "yes"})

        def _render_services(self) -> None:
            services = self.thinclient().get("services", {})
            if not isinstance(services, dict):
                services = {}
            active, total = service_count_summary(services)
            stream_state = services.get("stream", {}) if isinstance(services.get("stream"), dict) else {}
            agent_state = services.get("netbridge_agent", {}) if isinstance(services.get("netbridge_agent"), dict) else {}
            self.service_cards["active"].set_data(
                f"{active}/{total} aktiv",
                "Thinclient-Systemdienste",
                "ok" if total and active == total else "prüfen",
                "good" if total and active == total else "warn",
            )
            self.service_cards["stream"].set_data(
                str(stream_state.get("active", "-") or "-"),
                f"{stream_state.get('unit', '-') or '-'} | Start {stream_state.get('enabled', '-') or '-'}",
                str(stream_state.get("active", "-") or "-"),
                tone_for_state(stream_state.get("active", "-")),
            )
            self.service_cards["agent"].set_data(
                str(agent_state.get("active", "-") or "-"),
                f"{agent_state.get('unit', '-') or '-'} | Start {agent_state.get('enabled', '-') or '-'}",
                str(agent_state.get("active", "-") or "-"),
                tone_for_state(agent_state.get("active", "-")),
            )
            rows = []
            for key in sorted(services):
                state = services.get(key, {}) if isinstance(services.get(key), dict) else {}
                rows.append([service_label(key), state.get("active", "-"), state.get("enabled", "-"), state.get("unit", key)])
            self._set_rows(self.service_table, rows)

        def _render_usb_av(self) -> None:
            thin = self.thinclient()
            usb = thin.get("usb", {}) if isinstance(thin.get("usb"), dict) else {}
            devices = usb.get("devices", []) if isinstance(usb.get("devices"), list) else []
            audio = thin.get("audio", {}) if isinstance(thin.get("audio"), dict) else {}
            video = thin.get("video", {}) if isinstance(thin.get("video"), dict) else {}
            capture_devices = audio.get("capture_devices", []) if isinstance(audio.get("capture_devices"), list) else []
            video_devices = video.get("devices", []) if isinstance(video.get("devices"), list) else []
            self.usb_cards["tunnel"].set_data(
                str(usb.get("tunnel_state", "unknown") or "unknown"),
                f"Host {usb.get('attach_host', '-') or '-'}",
                "aktiv" if usb.get("tunnel_state") == "up" else "inaktiv",
                "good" if usb.get("tunnel_state") == "up" else "warn",
            )
            self.usb_cards["devices"].set_data(
                f"{len(devices)} erkannt",
                f"{usb.get('bound_count', 0) or 0} für VM freigegeben",
                "bereit" if devices else "leer",
                "good" if devices else "muted",
            )
            self.usb_cards["av"].set_data(
                f"{len(capture_devices)} Mikrofon · {len(video_devices)} Webcam",
                "Audio/Video vom Thinclient",
                "erkannt" if capture_devices or video_devices else "leer",
                "good" if capture_devices or video_devices else "muted",
            )
            self._set_rows(self.usb_table, [
                [
                    item.get("busid", item.get("id", "")),
                    "freigegeben" if item.get("bound") or item.get("exported") else "frei",
                    item.get("product") or item.get("name") or item.get("description") or f"USB-Port {item.get('busid', '-')}",
                    item.get("description") or item.get("class") or "-",
                ]
                for item in devices if isinstance(item, dict)
            ])
            rows = []
            for item in capture_devices:
                if isinstance(item, dict):
                    details = f"Karte {item.get('card', '-')}, Gerät {item.get('device', '-')} | {item.get('id', '-')}"
                    rows.append(["Mikrofon", item.get("name") or item.get("summary") or item.get("id") or "-", details])
            for item in video_devices:
                if isinstance(item, dict):
                    details = item.get("node") or item.get("id") or item.get("path") or "-"
                    rows.append(["Webcam", item.get("name") or item.get("node") or "-", details])
            self._set_rows(self.av_table, rows)

        def _render_devices(self) -> None:
            devices = self.catalog.get("devices", []) if self.catalog else []
            rows = []
            for device in devices:
                if not isinstance(device, dict):
                    continue
                queue = backend.queue_name(device)
                rows.append([
