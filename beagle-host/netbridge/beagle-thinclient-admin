                "bitrate": "Bitrate",
                "packet_size": "Paketgröße",
                "frame_pacing": "Frame pacing",
                "vsync": "VSync",
                "video_codec": "Codec",
                "video_decoder": "Decoder",
                "display_mode": "Anzeige",
