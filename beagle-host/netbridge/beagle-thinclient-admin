        def _render_network(self) -> None:
            network = self.thinclient().get("network", {})
            interfaces = network.get("interfaces", []) if isinstance(network, dict) else []
            lan = next((item for item in interfaces if isinstance(item, dict) and not item.get("wireless") and str(item.get("name", "")).startswith(("en", "eth"))), {})
            wireguard = next((item for item in interfaces if isinstance(item, dict) and str(item.get("name", "")).startswith("wg")), {})
            wifi = next((item for item in interfaces if isinstance(item, dict) and item.get("wireless")), {})
            self.network_cards["lan"].set_data(
                str(lan.get("ipv4", "-") or "-"),
                f"{lan.get('name', '-') or '-'} | {lan.get('speed_mbps', '-') or '-'} Mbit/s",
                str(lan.get("state", "unknown") or "unknown"),
                tone_for_state(lan.get("state", "unknown")),
            )
            self.network_cards["wireguard"].set_data(
                str(wireguard.get("ipv4", "-") or "-"),
                str(wireguard.get("name", "-") or "-"),
                "bereit" if wireguard else "fehlt",
                "good" if wireguard else "bad",
            )
            self.network_cards["wifi"].set_data(
                str(wifi.get("ipv4", "-") or "-"),
                str(wifi.get("name", "-") or "-"),
                str(wifi.get("state", "unknown") or "unknown") if wifi else "fehlt",
                tone_for_state(wifi.get("state", "unknown") if wifi else "missing"),
            )
            self._set_rows(self.network_table, [
                [
                    item.get("name", "-"),
                    item.get("state", "-"),
                    item.get("ipv4", "-"),
                    item.get("mac", "-"),
                    f"{item.get('speed_mbps')} Mbit/s" if item.get("speed_mbps") else "-",
