    app = QtWidgets.QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setApplicationDisplayName(APP_NAME)
    app.setDesktopFileName(APP_ID)
    window = AdminWindow()
    window.show()
    if screenshot_path:
        saved = {"done": False}

        def save_and_quit() -> None:
            if saved["done"]:
                return
            saved["done"] = True
            pixmap = window.grab()
            if not pixmap.save(screenshot_path):
                print(f"screenshot failed: {screenshot_path}", file=sys.stderr)
                app.exit(1)
                return
            print(f"screenshot: {screenshot_path}")
            app.quit()

        window.dataReady.connect(lambda *_args: QtCore.QTimer.singleShot(700, save_and_quit))
        QtCore.QTimer.singleShot(30000, save_and_quit)
    return app.exec_()


def selftest() -> int:
    control = backend.NetBridgeControl()
    print(f"backend: {backend.__file__}")
    print(f"agent endpoints: {control.endpoints}")
    print(f"update_state: {backend.guest_update_snapshot().get('state', 'unknown')}")
    status = control.status()
    if not isinstance(status, dict):
        print("agent_status: unavailable")
    else:
        thin = status.get("thinclient", {}) if isinstance(status.get("thinclient"), dict) else {}
        devices = status.get("devices", []) if isinstance(status.get("devices"), list) else []
        services = thin.get("services", {}) if isinstance(thin.get("services"), dict) else {}
        active, total = service_count_summary(services)
        print(f"agent_status: ok host={status.get('agent_host', '-')}")
        print(f"thinclient_sections: {','.join(sorted(thin.keys()))}")
        print(f"device_count: {len(devices)}")
        print(f"service_count: {active}/{total}")
    print("RESULT: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    if "--selftest" in argv:
        return selftest()
    screenshot_path = ""
    if "--screenshot" in argv:
        index = argv.index("--screenshot")
        if index + 1 >= len(argv):
            print("--screenshot requires a path", file=sys.stderr)
            return 2
        screenshot_path = argv[index + 1]
    return run_app(screenshot_path=screenshot_path)


if __name__ == "__main__":
    raise SystemExit(main())
