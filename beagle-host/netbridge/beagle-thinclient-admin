            }
            rows = [
                ["Aktives Profil", stream.get("profile", "-")],
                ["Profil-Datei", stream.get("profile_file", "-")],
                ["Auto-Bucket", auto.get("bucket", "-")],
                ["RTT Durchschnitt", auto.get("rtt_avg_ms", "-")],
                ["Paketverlust", auto.get("loss", "-")],
